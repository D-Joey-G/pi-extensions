{
  "name": "@djoeyg/pi-pair",
  "version": "0.1.0",
  "description": "Pair-coding mode for pi: you drive the keyboard, the agent navigates — watching your edits, asking questions, and suggesting designs instead of writing code for you",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pair-programming"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint src test && oxfmt --check src test",
    "lint:fix": "oxlint --fix src test && oxfmt src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "npm run check && npm run lint",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "diff": "^8.0.2",
    "ignore": "^7.0.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^24.5.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.20.6",
    "typebox": "^1.3.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "Joey Goldman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D-Joey-G/pi-extensions.git",
    "directory": "packages/pi-pair"
  },
  "homepage": "https://github.com/D-Joey-G/pi-extensions/tree/main/packages/pi-pair#readme",
  "bugs": "https://github.com/D-Joey-G/pi-extensions/issues",
  "files": [
    "src",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
