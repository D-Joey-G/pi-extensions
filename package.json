{
  "name": "pi-extensions",
  "private": true,
  "description": "Pi extensions monorepo",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json && npm run check -w @djoeyg/pi-pair",
    "test": "npm test -w @djoeyg/pi-pair -w @djoeyg/pi-emoji -w @djoeyg/pi-pr-comments",
    "lint": "oxlint packages && oxfmt --check packages",
    "changeset": "changeset",
    "release": "changeset publish",
    "format": "oxfmt packages"
  },
  "pi": {
    "extensions": [
      "./packages/pi-usage/index.ts",
      "./packages/pi-fast/index.ts",
      "./packages/pi-tps/index.ts",
      "./packages/pi-pair/src/index.ts",
      "./packages/pi-emoji/src/index.ts",
      "./packages/pi-ai-pair/src/index.ts",
      "./packages/pi-md/index.ts",
      "./packages/pi-pr-comments/src/index.ts",
      "./packages/pi-review/src/index.ts",
      "./packages/pi-smalltalk/src/index.ts"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^24.5.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typebox": "^1.3.36",
    "typescript": "^5.9.2"
  }
}
