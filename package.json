{
  "name": "pi-pair",
  "version": "0.1.0",
  "description": "Pair-coding mode for pi: you drive the keyboard, the agent navigates — watching your edits, asking questions, and suggesting designs instead of writing code for you",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pair-programming"
  ],
  "files": [
    "src",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "npm run check && npm run lint",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "diff": "^8.0.2",
    "ignore": "^7.0.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typebox": "^1.3.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
